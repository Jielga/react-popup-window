{
  "name": "@jielga/react-popup-window",
  "version": "0.1.0",
  "description": "React hook to open part of your UI in a separate browser popup window — live portal rendering, style syncing and cross-window messaging.",
  "type": "module",
  "license": "MIT",
  "author": "jielga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jielga/react-popup-window.git"
  },
  "homepage": "https://jielga.github.io/react-popup-window/",
  "bugs": {
    "url": "https://github.com/Jielga/react-popup-window/issues"
  },
  "keywords": [
    "react",
    "hook",
    "popup",
    "window",
    "portal",
    "window.open",
    "multi-window",
    "detached",
    "panel",
    "tanstack-intent"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "intent": {
    "docs": "README.md",
    "repo": "Jielga/react-popup-window"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite --config docs/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "docs:build": "vite build --config docs/vite.config.ts",
    "docs:preview": "vite preview --config docs/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "skills:validate": "node node_modules/@tanstack/intent/dist/cli.mjs validate",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-skill-version.mjs",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@jielga/tmdatagrid": "^2.0.0-beta.15",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@playwright/test": "^1.62.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/intent": "^0.3.6",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tanstack/store": "^0.11.1",
    "@tanstack/table-core": "^9.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
